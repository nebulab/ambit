{
  "name": "@nebulab/ambit",
  "version": "0.1.0",
  "description": "A deterministic dependency manager for AI-agent capabilities: skills, MCP servers and hooks, selected by name or tag.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nebulab/ambit.git"
  },
  "homepage": "https://github.com/nebulab/ambit#readme",
  "bugs": "https://github.com/nebulab/ambit/issues",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "ambit": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "build:binaries": "bun run scripts/build.ts --binaries",
    "fixture": "bun run scripts/fixture-catalog.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "commander": "^13.0.0",
    "gray-matter": "^4.0.3",
    "jsonc-parser": "^3.3.1",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/bun": "^1.3.14",
    "eslint": "^9.17.0",
    "prettier": "3.9.6",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  }
}
